# MetaForge Environment Configuration Template
APP_ENV=production
DEMO_MODE=true
PORT=8000
LOG_LEVEL=INFO

# Container Registry & Repository References
CONTAINER_REGISTRY=ghcr.io/metaforge/metatag-generator
DOCKER_IMAGE_TAG=1.4.2

# Kubernetes Cluster Configuration
KUBERNETES_CLUSTER=metaforge-cluster
KUBERNETES_NAMESPACE=metaforge-prod
REPLICAS=3

# Security Credentials Note:
# Never commit actual secret keys or passwords to GitHub.
# Use Kubernetes Secrets or Jenkins Credentials Manager.
